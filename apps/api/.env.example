# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printforge

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# S3/R2 Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=printforge-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=quotes@yourdomain.com
EMAIL_FROM_NAME=PrintForge

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Slicer
SLICER_PATH=/usr/bin/prusa-slicer
SLICER_PROFILES_PATH=/app/slicer-profiles

# App URLs
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
WIDGET_URL=http://localhost:3000

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
